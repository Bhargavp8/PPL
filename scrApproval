              =Set(varSelectedNote, drpDeliveryNote1.Selected.Value);

              ClearCollect(colToReject,
                  Filter(
                      Filter('3PL request',
                          (Status = "Pending Manager Approval" || Status = "Pending Inspector Approval") &&
                          (DeliveryNoteNumber = varSelectedNote || ReturnDeliveryNoteNumber = varSelectedNote)
                      ) As Row,
                      IsBlank(LookUp(colApprExcluded, ID = Row.ID))
                  )
              );

              If(CountRows(colToReject) = 0,
                  Notify("Tick at least one line to reject.", NotificationType.Error),

                  ForAll(colToReject, Patch('3PL request', {ID: ID}, {
                      Status: "Rejected",
                      RejectedBy: "Digitally signed: " & User().FullName & " - " & Text(Now(), "dd/mm/yyyy hh:mm"),
                      DateRejected: Now()
                  }));

                  Notify("Rejected " & CountRows(colToReject) & " line(s) on " & varSelectedNote, NotificationType.Success);
                  Navigate(scrHome, ScreenTransition.Fade)
