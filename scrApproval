Screens:
  scrApproval:
    Properties:
      Fill: =RGBA(194, 155, 39, 1)
      LoadingSpinnerColor: =RGBA(0, 120, 212, 1)
      OnVisible: |-
        =ClearCollect(colMyRoles, Filter('3PL Approvers', Lower(Trim(Email)) = Lower(Trim(User().Email))));
        Set(varIsSuperUser, !IsBlank(LookUp('3PL Approvers', Lower(Trim(Email)) = Lower(Trim(User().Email)) && Role = "Super User")))
