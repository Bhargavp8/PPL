      - Button7:
          Control: Classic/Button@2.2.0
          Properties:
            BorderColor: =RGBA(0, 0, 0, 0)
            BorderStyle: =BorderStyle.None
            Color: =RGBA(255, 255, 255, 1)
            DisabledBorderColor: =RGBA(0, 0, 0, 0)
            DisabledColor: =RGBA(161, 159, 157, 1)
            DisabledFill: =RGBA(242, 242, 241, 0)
            Fill: =RGBA(0, 0, 0, 1)
            Font: =Font.'Segoe UI'
            HoverBorderColor: =RGBA(0, 0, 0, 0)
            HoverColor: =RGBA(255, 255, 255, 1)
            HoverFill: =RGBA(16, 110, 190, 1)
            OnSelect: |-
              =ClearCollect(colToApprove, Filter('3PL request', DeliveryNoteNumber = drpDeliveryNote1.Selected.Value || ReturnDeliveryNoteNumber = drpDeliveryNote1.Selected.Value));

              Set(varSelectedNote, drpDeliveryNote1.Selected.Value);

              If(
                  First(colToApprove).Status = "Pending Inspector Approval",
                  ForAll(colToApprove, Patch('3PL request', {ID: ID}, {
                      Status: "Closed",
                      InspectorApprovedBy: "Digitally signed: " & User().FullName & " - " & Text(Now(), "dd/mm/yyyy hh:mm"),
                      DateClosed: Now()
                  })),

                  IsBlank(First(colToApprove).ReturnDeliveryNoteNumber),
                  ForAll(colToApprove, Patch('3PL request', {ID: ID}, {
                      Status: "Requested (to Warehouse)",
                      SendApprovedBy: "Digitally signed: " & User().FullName & " - " & Text(Now(), "dd/mm/yyyy hh:mm")
                  })); SendDeliveryNoteEmail.Run(varSelectedNote),

                  ForAll(colToApprove, Patch('3PL request', {ID: ID}, {
                      Status: "Requested (to Facility)",
                      ReturnApprovedBy: "Digitally signed: " & User().FullName & " - " & Text(Now(), "dd/mm/yyyy hh:mm")
                  })); SendDeliveryNoteEmail.Run(varSelectedNote)
              );

              Notify("Approved — " & varSelectedNote, NotificationType.Success);
              Navigate(scrHome, ScreenTransition.Fade)
            PressedBorderColor: =RGBA(0, 69, 120, 1)
            PressedColor: =RGBA(255, 255, 255, 1)
            PressedFill: =RGBA(16, 110, 190, 1)
            RadiusBottomLeft: =0
            RadiusBottomRight: =0
            RadiusTopLeft: =0
            RadiusTopRight: =0
            Text: ="Approve"
            X: =76
            Y: =672
