Screens:
  scrApproval:
    Properties:
      Fill: =RGBA(194, 155, 39, 1)
      LoadingSpinnerColor: =RGBA(0, 120, 212, 1)
      OnVisible: |-
        =ClearCollect(colMyRoles, Filter('3PL Approvers', Lower(Trim(Email)) = Lower(Trim(User().Email))));
        Set(varIsSuperUser, !IsBlank(LookUp('3PL Approvers', Lower(Trim(Email)) = Lower(Trim(User().Email)) && Role = "Super User")));
        Clear(colApprExcluded)
    Children:
      - drpDeliveryNote1:
          Control: Classic/DropDown@2.3.1
          Properties:
            BorderColor: =RGBA(245, 245, 245, 1)
            ChevronBackground: =RGBA(245, 245, 245, 1)
            ChevronDisabledBackground: =RGBA(242, 242, 241, 0)
            ChevronDisabledFill: =RGBA(161, 159, 157, 1)
            ChevronFill: =RGBA(50, 49, 48, 1)
            ChevronHoverBackground: =RGBA(245, 245, 245, 1)
            ChevronHoverFill: =RGBA(50, 49, 48, 1)
            Color: =RGBA(50, 49, 48, 1)
            DisabledBorderColor: =RGBA(0, 0, 0, 0)
            DisabledColor: =RGBA(161, 159, 157, 1)
            DisabledFill: =RGBA(242, 242, 241, 0)
            Fill: =RGBA(245, 245, 245, 1)
            Font: =Font.'Segoe UI'
            HoverBorderColor: =RGBA(16, 110, 190, 1)
            HoverColor: =RGBA(50, 49, 48, 1)
            HoverFill: =RGBA(245, 245, 245, 1)
            Items: |-
              =Distinct(
                  Search(
                      Filter('3PL request',
                          (Status = "Pending Manager Approval" && (varIsSuperUser || CountRows(Filter(colMyRoles, Role = "Manager")) > 0)) ||
                          (Status = "Pending Inspector Approval" && (varIsSuperUser || CountRows(Filter(colMyRoles, Role = "Inspector")) > 0))
                      ),
                      txtApprSearch.Text, 'Sales Order', 'Part Number', Description, TrolleyNumber, Remark, ReturnRemark, DeliveryNoteNumber, ReturnDeliveryNoteNumber
                  ),
                  If(Status = "Pending Inspector Approval" || !IsBlank(ReturnDeliveryNoteNumber), ReturnDeliveryNoteNumber, DeliveryNoteNumber)
              )
            Items.Value: =Value
            OnChange: =Clear(colApprExcluded)
            PaddingBottom: =5
            PaddingLeft: =12
            PaddingRight: =5
            PaddingTop: =5
            PressedBorderColor: =RGBA(16, 110, 190, 1)
            PressedColor: =RGBA(255, 255, 255, 1)
            PressedFill: =RGBA(0, 120, 212, 1)
            SelectionColor: =RGBA(50, 49, 48, 1)
            SelectionFill: =RGBA(0, 120, 212, 1)
            Width: =300
            X: =404
            Y: =112
