      - btnRcvConfirm:
          Control: Classic/Button@2.2.0
          Properties:
            BorderColor: =RGBA(0, 0, 0, 0)
            BorderStyle: =BorderStyle.None
            Color: =RGBA(255, 255, 255, 1)
            DisabledBorderColor: =RGBA(0, 0, 0, 0)
            DisabledColor: =RGBA(161, 159, 157, 1)
            DisabledFill: =RGBA(242, 242, 241, 0)
            DisplayMode: =If(CountRows(colReceiptSelections) = 0, DisplayMode.Disabled, DisplayMode.Edit)
            Fill: =RGBA(0, 0, 0, 1)
            Font: =Font.'Segoe UI'
            HoverBorderColor: =RGBA(0, 0, 0, 0)
            HoverColor: =RGBA(255, 255, 255, 1)
            HoverFill: =RGBA(16, 110, 190, 1)
            OnSelect: |-
              =If(CountRows(colReceiptSelections) = 0,
                  Notify("Tick at least one line before confirming receipt.", NotificationType.Error),

                  ForAll(colReceiptSelections As Sel,
                      Patch('3PL request', {ID: Sel.ID}, {
                          Status: "Received",
                          ReceivedBy: "Digitally signed: " & User().FullName & " - " & Text(Now(), "dd/mm/yyyy hh:mm"),
                          DateReceived: Now()
                      })
                  );

                  Notify(CountRows(colReceiptSelections) & " line(s) marked as received.", NotificationType.Success);
                  Clear(colReceiptSelections);
                  Navigate(scrHome, ScreenTransition.Fade)
              )
            PressedBorderColor: =RGBA(0, 69, 120, 1)
            PressedColor: =RGBA(255, 255, 255, 1)
            PressedFill: =RGBA(16, 110, 190, 1)
            RadiusBottomLeft: =0
            RadiusBottomRight: =0
            RadiusTopLeft: =0
            RadiusTopRight: =0
            Text: ="Confirm received"
            Width: =200
            X: =86
            Y: =641
