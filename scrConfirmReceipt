                  OnUncheck: =Remove(colReceiptSelections, LookUp(colReceiptSelections, ID = ThisItem.ID))
                  PressedBorderColor: =RGBA(0, 0, 0, 0)
                  PressedColor: =RGBA(50, 49, 48, 1)
