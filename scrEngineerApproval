      - btnEngApprove:
          Control: Classic/Button@2.2.0
          Properties:
            BorderColor: =RGBA(0, 0, 0, 0)
            BorderStyle: =BorderStyle.None
            Color: =RGBA(255, 255, 255, 1)
            DisabledBorderColor: =RGBA(0, 0, 0, 0)
            DisabledColor: =RGBA(161, 159, 157, 1)
            DisabledFill: =RGBA(242, 242, 241, 0)
            DisplayMode: =If(IsBlank(drpEngNote.Selected.Value), DisplayMode.Disabled, DisplayMode.Edit)
            Fill: =RGBA(0, 0, 0, 1)
            Font: =Font.'Segoe UI'
            HoverBorderColor: =RGBA(0, 0, 0, 0)
            HoverColor: =RGBA(255, 255, 255, 1)
            HoverFill: =RGBA(16, 110, 190, 1)
            OnSelect: |-
              =Set(varEngNote, drpEngNote.Selected.Value);

              ClearCollect(colEngApprove,
                  Filter('3PL request',
                      Status = "Pending Engineer Approval" &&
                      ReturnDeliveryNoteNumber = varEngNote
                  )
              );

              If(CountRows(colEngApprove) = 0,
                  Notify("Nothing to approve for " & varEngNote & ".", NotificationType.Error),

                  ForAll(colEngApprove,
                      Patch('3PL request', {ID: ID}, {
                          Status: "Returned (Awaiting Receipt)",
                          EngineerApprovedBy: "Digitally signed: " & User().FullName & " - " & Text(Now(), "dd/mm/yyyy hh:mm"),
                          DateEngineerApproved: Now()
                      })
                  );

                  Set(varLogisticsTo, Concat(Filter('3PL Approvers', Role = "Logistics"), Email, ";"));
                  Set(varRequestorTo, Concat(Distinct(colEngApprove, ReturnRequestedBy), Value, ";"));

                  Set(varEngTable,
                      "<table style='border-collapse:collapse;width:100%;font-family:sans-serif;font-size:13px;'>" &
                      "<tr><th style='border:1px solid #999;padding:6px 10px;background-color:#f2f2f2;text-align:left;'>Sales Order</th><th style='border:1px solid #999;padding:6px 10px;background-color:#f2f2f2;text-align:left;'>Part Number</th><th style='border:1px solid #999;padding:6px 10px;background-color:#f2f2f2;text-align:left;'>Qty</th><th style='border:1px solid #999;padding:6px 10px;background-color:#f2f2f2;text-align:left;'>Trolley No.</th><th style='border:1px solid #999;padding:6px 10px;background-color:#f2f2f2;text-align:left;'>Remark</th></tr>" &
                      Concat(colEngApprove,
                          "<tr><td style='border:1px solid #999;padding:6px 10px;'>" & 'Sales Order' & "</td><td style='border:1px solid #999;padding:6px 10px;'>" & 'Part Number' & "</td><td style='border:1px solid #999;padding:6px 10px;'>" & Qty & "</td><td style='border:1px solid #999;padding:6px 10px;'>" & TrolleyNumber & "</td><td style='border:1px solid #999;padding:6px 10px;'>" & ReturnRemark & "</td></tr>"
                      ) &
                      "</table>"
                  );

                  If(IsBlank(varRequestorTo) && IsBlank(varLogisticsTo),
                      Notify("Approved, but no requestor or Logistics address was found to notify.", NotificationType.Warning),
                      Office365Outlook.SendEmailV2(
                          Coalesce(varRequestorTo, varLogisticsTo),
                          "Approved: " & varEngNote & " - return to facility",
                          "<p>Hello,</p>" &
                          "<p>Return request <b>" & varEngNote & "</b> has been approved by Engineering and is now awaiting receipt at the facility.</p>" &
                          varEngTable &
                          "<p>The requestor should confirm receipt in the 3PL app once the parts arrive.</p>" &
                          "<p>Regards,<br>" & User().FullName & "</p>" &
                          "<p style='font-size:12px;color:#888;font-style:italic;'>This is an automated email.</p>",
                          {Cc: If(IsBlank(varRequestorTo), "", varLogisticsTo)}
                      )
                  );

                  Notify("Approved - " & varEngNote & ". Awaiting receipt.", NotificationType.Success);
                  Navigate(scrHome, ScreenTransition.Fade)
              )
            PressedBorderColor: =RGBA(0, 69, 120, 1)
            PressedColor: =RGBA(255, 255, 255, 1)
            PressedFill: =RGBA(16, 110, 190, 1)
            RadiusBottomLeft: =0
            RadiusBottomRight: =0
            RadiusTopLeft: =0
            RadiusTopRight: =0
            Text: ="Approve"
            Width: =160
            X: =76
            Y: =672
