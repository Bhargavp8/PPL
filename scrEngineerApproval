      - btnEngApprove:
          Control: Classic/Button@2.2.0
          Properties:
            BorderColor: =RGBA(0, 0, 0, 0)
            BorderStyle: =BorderStyle.None
            Color: =RGBA(255, 255, 255, 1)
            DisabledBorderColor: =RGBA(0, 0, 0, 0)
            DisabledColor: =RGBA(161, 159, 157, 1)
            DisabledFill: =RGBA(242, 242, 241, 0)
            DisplayMode: =If(IsBlank(drpEngNote.Selected.Value), DisplayMode.Disabled, DisplayMode.Edit)
            Fill: =RGBA(0, 0, 0, 1)
            Font: =Font.'Segoe UI'
            HoverBorderColor: =RGBA(0, 0, 0, 0)
            HoverColor: =RGBA(255, 255, 255, 1)
            HoverFill: =RGBA(16, 110, 190, 1)
            OnSelect: |-
              =Set(varEngNote, drpEngNote.Selected.Value);

              ClearCollect(colEngApprove,
                  Filter(
                      Filter('3PL request',
                          Status = "Pending Engineer Approval" &&
                          ReturnDeliveryNoteNumber = varEngNote
                      ) As Row,
                      IsBlank(LookUp(colEngExcluded, ID = Row.ID))
                  )
              );

              If(CountRows(colEngApprove) = 0,
                  Notify("Tick at least one line to approve.", NotificationType.Error),

                  ForAll(colEngApprove,
                      Patch('3PL request', {ID: ID}, {
                          Status: "Engineer Approved (Awaiting Return)",
                          EngineerApprovedBy: "Digitally signed: " & User().FullName & " - " & Text(Now(), "dd/mm/yyyy hh:mm"),
                          DateEngineerApproved: Now()
                      })
                  );

                  SDNE.Run(varEngNote);

                  Set(varRequestorTo, Concat(Filter(Distinct(colEngApprove, ReturnRequestedBy), !IsBlank(Value)), Value, ";"));

                  If(IsBlank(varRequestorTo),
                      Notify("Approved, but no requestor address was found to notify.", NotificationType.Warning),
                      Office365Outlook.SendEmailV2(
                          varRequestorTo,
                          "[FYI] " & varEngNote & " — approved, Logistics arranging collection",
                          "<p>Your return request <b>" & varEngNote & "</b> (" & CountRows(colEngApprove) & " lines) has been approved by Engineering. Logistics has the return delivery note and is arranging collection from the warehouse.</p>" &
                          "<p>You will need to confirm receipt in the app once the parts reach you.</p>" &
                          "<p><a href='" & varAppLink & "&Note=" & varEngNote & "'>View " & varEngNote & "</a></p>" &
                          "<p style='font-size:12px;color:#888;font-style:italic;'>Status update only — no action needed from you yet.</p>"
                      )
                  );

                  Notify("Approved " & CountRows(colEngApprove) & " line(s) on " & varEngNote & ". Awaiting receipt.", NotificationType.Success);
                  Navigate(scrHome, ScreenTransition.Fade)
              )
            PressedBorderColor: =RGBA(0, 69, 120, 1)
            PressedColor: =RGBA(255, 255, 255, 1)
            PressedFill: =RGBA(16, 110, 190, 1)
            RadiusBottomLeft: =0
            RadiusBottomRight: =0
            RadiusTopLeft: =0
            RadiusTopRight: =0
            Text: ="Approve"
