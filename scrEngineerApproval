            Fill: =RGBA(0, 0, 0, 1)
            Font: =Font.'Segoe UI'
            HoverBorderColor: =RGBA(0, 0, 0, 0)
            HoverColor: =RGBA(255, 255, 255, 1)
            HoverFill: =RGBA(16, 110, 190, 1)
            OnSelect: |-
              =Set(varEngNote, drpEngNote.Selected.Value);

              ClearCollect(colEngReject,
                  Filter(
                      Filter('3PL request',
                          Status = "Pending Engineer Approval" &&
                          ReturnDeliveryNoteNumber = varEngNote
                      ) As Row,
                      IsBlank(LookUp(colEngExcluded, ID = Row.ID))
                  )
              );

              If(CountRows(colEngReject) = 0,
                  Notify("Tick at least one line to reject.", NotificationType.Error),

                  ForAll(colEngReject,
                      Patch('3PL request', {ID: ID}, {
                          Status: "Rejected",
                          RejectedBy: "Digitally signed: " & User().FullName & " - " & Text(Now(), "dd/mm/yyyy hh:mm"),
                          DateRejected: Now()
                      })
                  );

                  Set(varEngRejTo, Concat(Filter(Distinct(colEngReject, ReturnRequestedBy), !IsBlank(Value)), Value, ";"));
                  Set(varEngRejLogistics, Concat(Filter('3PL Approvers', Role = "Logistics" && !IsBlank(Email)), Email, ";"));

                  If(!IsBlank(varEngRejTo),
                      Office365Outlook.SendEmailV2(
                          varEngRejTo,
                          "[ACTION] " & varEngNote & " — return rejected, please review",
                          "<p>Hello,</p>" &
                          "<p>Your return request <b>" & varEngNote & "</b> (" & CountRows(colEngReject) & " lines) was <b>not approved</b> by " & User().FullName & ".</p>" &
                          "<p>The parts remain in storage at the warehouse. Please review and resubmit if the return is still needed.</p>" &
                          "<p><a href='" & varAppLink & "&Note=" & varEngNote & "'>View " & varEngNote & "</a></p>" &
                          "<p style='font-size:12px;color:#888;font-style:italic;'>This is an automated email.</p>",
                          {Importance: "High"}
                      )
                  );

                  If(!IsBlank(varEngRejLogistics),
                      Office365Outlook.SendEmailV2(
                          varEngRejLogistics,
                          "[FYI] " & varEngNote & " — return rejected, no collection needed",
                          "<p>Return request <b>" & varEngNote & "</b> (" & CountRows(colEngReject) & " lines) was rejected by Engineering. No collection is required — the parts stay in storage.</p>" &
                          "<p><a href='" & varAppLink & "&Note=" & varEngNote & "'>View " & varEngNote & "</a></p>" &
                          "<p style='font-size:12px;color:#888;font-style:italic;'>Status update only — no action needed from you.</p>"
                      )
                  );

                  Notify("Rejected " & CountRows(colEngReject) & " line(s) on " & varEngNote, NotificationType.Success);
                  Navigate(scrHome, ScreenTransition.Fade)
              )
            PressedBorderColor: =RGBA(0, 69, 120, 1)
            PressedColor: =RGBA(255, 255, 255, 1)
