      - Button6:
          Control: Classic/Button@2.2.0
          Properties:
            BorderColor: =RGBA(0, 0, 0, 0)
            BorderStyle: =BorderStyle.None
            Color: =RGBA(255, 255, 255, 1)
            DisabledBorderColor: =RGBA(0, 0, 0, 0)
            DisabledColor: =RGBA(161, 159, 157, 1)
            DisabledFill: =RGBA(242, 242, 241, 0)
            DisplayMode: =If(IsBlank(drpDeliveryNote.Selected.Value), DisplayMode.Disabled, DisplayMode.Edit)
            Fill: =RGBA(0, 0, 0, 1)
            Font: =Font.'Segoe UI'
            HoverBorderColor: =RGBA(0, 0, 0, 0)
            HoverColor: =RGBA(255, 255, 255, 1)
            HoverFill: =RGBA(16, 110, 190, 1)
            OnSelect: |-
              =ClearCollect(colToUpdate,
                  Filter('3PL request', (DeliveryNoteNumber = drpDeliveryNote.Selected.Value && Status = "Requested (to Warehouse)") || (ReturnDeliveryNoteNumber = drpDeliveryNote.Selected.Value && Status = "Requested (to Facility)"))
              );

              Set(varNewStatus, If(First(colToUpdate).Status = "Requested (to Warehouse)", "In Storage", "Pending Inspector Approval"));

              If(varNewStatus = "In Storage",
                  ForAll(colToUpdate, Patch('3PL request', {ID: ID}, {Status: varNewStatus, DateInStorage: Now()})),
                  ForAll(colToUpdate, Patch('3PL request', {ID: ID}, {Status: varNewStatus}))
              );

              Notify("Updated to " & varNewStatus, NotificationType.Success);
              Reset(drpDeliveryNote)
            PressedBorderColor: =RGBA(0, 69, 120, 1)
            PressedColor: =RGBA(255, 255, 255, 1)
            PressedFill: =RGBA(16, 110, 190, 1)
            RadiusBottomLeft: =0
            RadiusBottomRight: =0
            RadiusTopLeft: =0
            RadiusTopRight: =0
            Text: |-
              =If(
                  LookUp('3PL request', (DeliveryNoteNumber = drpDeliveryNote.Selected.Value && Status = "Requested (to Warehouse)") || (ReturnDeliveryNoteNumber = drpDeliveryNote.Selected.Value && Status = "Requested (to Facility)")).Status = "Requested (to Warehouse)",
