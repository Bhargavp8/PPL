      - Button4:
          Control: Classic/Button@2.2.0
          Properties:
            BorderColor: =RGBA(0, 0, 0, 0)
            BorderStyle: =BorderStyle.None
            Color: =RGBA(255, 255, 255, 1)
            DisabledBorderColor: =RGBA(0, 0, 0, 0)
            DisabledColor: =RGBA(161, 159, 157, 1)
            DisabledFill: =RGBA(242, 242, 241, 0)
            Fill: =RGBA(0, 0, 0, 1)
            Font: =Font.'Segoe UI'
            HoverBorderColor: =RGBA(0, 0, 0, 0)
            HoverColor: =RGBA(255, 255, 255, 1)
            HoverFill: =RGBA(16, 110, 190, 1)
            OnSelect: |-
              =If(CountRows(colReturnSelections) = 0,
                  Notify("Tick at least one line before submitting.", NotificationType.Error),

                  Set(varMaxReturnNum,
                      IfError(
                          Value(
                              Mid(
                                  First(
                                      Sort(
                                          Filter('3PL request', StartsWith(ReturnDeliveryNoteNumber, "R-")),
                                          ReturnDeliveryNoteNumber,
                                          SortOrder.Descending
                                      )
                                  ).ReturnDeliveryNoteNumber,
                                  3
                              )
                          ),
                          0
                      )
                  );
                  Set(varDeliveryNote, "R-" & Text(Coalesce(varMaxReturnNum, 0) + 1, "0000"));

                  ForAll(colReturnSelections As Sel,
                      Patch('3PL request', {ID: Sel.ID}, {
                          Status: "Pending Engineer Approval",
                          ReturnDeliveryNoteNumber: varDeliveryNote,
                          ReturnRemark: Sel.Remark,
                          ReturnRequestedBy: User().Email,
                          DateRequestedFacility: Now()
                      })
                  );

                  Set(varLineItemsTable,
                      "<table style='border-collapse:collapse;width:100%;font-family:sans-serif;font-size:13px;'>" &
                      "<tr><th style='border:1px solid #999;padding:6px 10px;background-color:#f2f2f2;text-align:left;'>Sales Order</th><th style='border:1px solid #999;padding:6px 10px;background-color:#f2f2f2;text-align:left;'>Part Number</th><th style='border:1px solid #999;padding:6px 10px;background-color:#f2f2f2;text-align:left;'>Description</th><th style='border:1px solid #999;padding:6px 10px;background-color:#f2f2f2;text-align:left;'>Qty</th><th style='border:1px solid #999;padding:6px 10px;background-color:#f2f2f2;text-align:left;'>Trolley No.</th><th style='border:1px solid #999;padding:6px 10px;background-color:#f2f2f2;text-align:left;'>Remark</th></tr>" &
                      Concat(colReturnSelections As Sel,
                          With({Row: LookUp('3PL request', ID = Sel.ID)},
                              "<tr><td style='border:1px solid #999;padding:6px 10px;'>" & Row.'Sales Order' & "</td><td style='border:1px solid #999;padding:6px 10px;'>" & Row.'Part Number' & "</td><td style='border:1px solid #999;padding:6px 10px;'>" & Row.Description & "</td><td style='border:1px solid #999;padding:6px 10px;'>" & Row.Qty & "</td><td style='border:1px solid #999;padding:6px 10px;'>" & Row.TrolleyNumber & "</td><td style='border:1px solid #999;padding:6px 10px;'>" & Sel.Remark & "</td></tr>"
                          )
                      ) &
                      "</table>"
                  );

                  Set(varEngineerTo, Concat(Filter('3PL Approvers', Role = "Engineer" && !IsBlank(Email)), Email, ";"));
                  Set(varLogisticsTo, Concat(Filter('3PL Approvers', Role = "Logistics" && !IsBlank(Email)), Email, ";"));

                  If(IsBlank(varEngineerTo),
                      Notify("Saved, but no Engineer is listed in '3PL Approvers' so no approval email was sent.", NotificationType.Warning),
                      Office365Outlook.SendEmailV2(
                          varEngineerTo,
                          "Action required: Approve " & varDeliveryNote & " - return to facility",
                          "<p>Hello,</p>" &
                          "<p>Please help to approve the request: " & varDeliveryNote & " - parts requested to return to facility.</p>" &
                          varLineItemsTable &
                          "<p>Regards,<br>" & User().FullName & "</p>" &
                          "<p style='font-size:12px;color:#888;font-style:italic;'>This is an automated email.</p>",
                          {Cc: varLogisticsTo}
                      )
                  );

                  Clear(colReturnSelections);
                  Notify("Return submitted to Engineering — Delivery Note " & varDeliveryNote, NotificationType.Success);
                  Navigate(scrHome, ScreenTransition.Fade)
              )
            PressedBorderColor: =RGBA(0, 69, 120, 1)
            PressedColor: =RGBA(255, 255, 255, 1)
            PressedFill: =RGBA(16, 110, 190, 1)
            RadiusBottomLeft: =0
